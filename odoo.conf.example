[options]
; Database settings
db_host = localhost
db_port = 5432
db_user = odoo
db_password = your_password_here

; Addons path
addons_path = odoo/odoo/addons,odoo/addons,custom_addons

; Logging
logfile = odoo.log
log_level = info

; Server settings
http_port = 8069
http_interface = 127.0.0.1
workers = 0

; PDF Generation (install wkhtmltopdf first)
; wkhtmltopdf_path = C:/Program Files/wkhtmltopdf/bin/wkhtmltopdf.exe
