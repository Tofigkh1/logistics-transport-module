<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Location Tree View -->
    <record id="view_logistics_location_tree" model="ir.ui.view">
        <field name="name">logistics.location.tree</field>
        <field name="model">logistics.location</field>
        <field name="arch" type="xml">
            <tree string="Locations">
                <field name="name"/>
                <field name="location_type" widget="badge" 
                    decoration-info="location_type == 'warehouse'"
                    decoration-success="location_type == 'customer'"
                    decoration-warning="location_type == 'port'"/>
                <field name="city"/>
                <field name="country_id"/>
                <field name="partner_id"/>
                <field name="phone"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Location Form View -->
    <record id="view_logistics_location_form" model="ir.ui.view">
        <field name="name">logistics.location.form</field>
        <field name="model">logistics.location</field>
        <field name="arch" type="xml">
            <form string="Location">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Location Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Location Details">
                            <field name="location_type" widget="radio"/>
                            <field name="partner_id"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Contact">
                            <field name="phone" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                    </group>
                    <group>
                        <group string="Address">
                            <field name="street" placeholder="Street..."/>
                            <field name="street2"/>
                            <field name="city"/>
                            <field name="state_id" options="{'no_create': True}"/>
                            <field name="zip"/>
                            <field name="country_id" options="{'no_create': True}"/>
                        </group>
                        <group string="GPS Coordinates">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="complete_address" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Location Search View -->
    <record id="view_logistics_location_search" model="ir.ui.view">
        <field name="name">logistics.location.search</field>
        <field name="model">logistics.location</field>
        <field name="arch" type="xml">
            <search string="Search Locations">
                <field name="name"/>
                <field name="city"/>
                <field name="partner_id"/>
                <filter string="Warehouses" name="warehouse" domain="[('location_type', '=', 'warehouse')]"/>
                <filter string="Customer Locations" name="customer" domain="[('location_type', '=', 'customer')]"/>
                <filter string="Ports" name="port" domain="[('location_type', '=', 'port')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'location_type'}"/>
                    <filter string="City" name="group_city" context="{'group_by': 'city'}"/>
                    <filter string="Country" name="group_country" context="{'group_by': 'country_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Location Kanban View -->
    <record id="view_logistics_location_kanban" model="ir.ui.view">
        <field name="name">logistics.location.kanban</field>
        <field name="model">logistics.location</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="city"/>
                <field name="location_type"/>
                <field name="phone"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge text-bg-info">
                                        <field name="location_type"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="city"/><t t-if="record.city.raw_value">, </t>
                                    <field name="country_id"/>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <field name="phone" widget="phone"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Location Action -->
    <record id="action_logistics_location" model="ir.actions.act_window">
        <field name="name">Locations</field>
        <field name="res_model">logistics.location</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="search_view_id" ref="view_logistics_location_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first location
            </p>
            <p>
                Locations are used as pickup and delivery points for shipments.
            </p>
        </field>
    </record>
</odoo>
