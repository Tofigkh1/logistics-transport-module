<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Driver Tree View -->
    <record id="view_logistics_driver_tree" model="ir.ui.view">
        <field name="name">logistics.driver.tree</field>
        <field name="model">logistics.driver</field>
        <field name="arch" type="xml">
            <tree string="Drivers" decoration-danger="not license_is_valid" decoration-muted="status == 'on_leave'">
                <field name="name"/>
                <field name="phone"/>
                <field name="license_number"/>
                <field name="license_type"/>
                <field name="license_expiry"/>
                <field name="license_is_valid" invisible="1"/>
                <field name="current_vehicle_id"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'available'"
                    decoration-info="status == 'on_trip'"
                    decoration-warning="status == 'off_duty'"
                    decoration-muted="status == 'on_leave'"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Driver Form View -->
    <record id="view_logistics_driver_form" model="ir.ui.view">
        <field name="name">logistics.driver.form</field>
        <field name="model">logistics.driver</field>
        <field name="arch" type="xml">
            <form string="Driver">
                <header>
                    <button name="action_set_available" string="Set Available" type="object" 
                        class="oe_highlight" invisible="status == 'available'"/>
                    <button name="action_set_off_duty" string="Off Duty" type="object"
                        invisible="status in ('off_duty', 'on_leave')"/>
                    <button name="action_set_on_leave" string="On Leave" type="object"
                        invisible="status == 'on_leave'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,on_trip,off_duty"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_logistics_shipment)d" type="action"
                            class="oe_stat_button" icon="fa-truck"
                            context="{'search_default_driver_id': active_id}">
                            <field name="completed_trips" string="Trips" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <widget name="web_ribbon" title="License Expired" bg_color="text-bg-danger" invisible="license_is_valid"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Driver Name"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Contact Information">
                            <field name="partner_id"/>
                            <field name="employee_code"/>
                            <field name="phone" widget="phone"/>
                            <field name="mobile" widget="phone"/>
                            <field name="email" widget="email"/>
                        </group>
                        <group string="License Information">
                            <field name="license_number"/>
                            <field name="license_type"/>
                            <field name="license_expiry"/>
                            <field name="license_is_valid"/>
                        </group>
                    </group>
                    <group>
                        <group string="Current Assignment">
                            <field name="current_vehicle_id"/>
                            <field name="current_shipment_id"/>
                            <field name="is_available"/>
                        </group>
                        <group string="Personal Information">
                            <field name="date_of_birth"/>
                            <field name="address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Emergency Contact" name="emergency">
                            <group>
                                <group>
                                    <field name="emergency_contact"/>
                                    <field name="emergency_phone" widget="phone"/>
                                </group>
                            </group>
                        </page>
                        <page string="Statistics" name="statistics">
                            <group>
                                <group>
                                    <field name="total_trips"/>
                                    <field name="completed_trips"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Driver Search View -->
    <record id="view_logistics_driver_search" model="ir.ui.view">
        <field name="name">logistics.driver.search</field>
        <field name="model">logistics.driver</field>
        <field name="arch" type="xml">
            <search string="Search Drivers">
                <field name="name"/>
                <field name="phone"/>
                <field name="license_number"/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="On Trip" name="on_trip" domain="[('status', '=', 'on_trip')]"/>
                <filter string="Off Duty" name="off_duty" domain="[('status', '=', 'off_duty')]"/>
                <separator/>
                <filter string="License Expiring Soon" name="expiring" 
                    domain="[('license_expiry', '&lt;=', (context_today() + relativedelta(days=30)).strftime('%Y-%m-%d'))]"/>
                <filter string="License Expired" name="expired" 
                    domain="[('license_is_valid', '=', False)]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="License Type" name="group_license" context="{'group_by': 'license_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Driver Kanban View -->
    <record id="view_logistics_driver_kanban" model="ir.ui.view">
        <field name="name">logistics.driver.kanban</field>
        <field name="model">logistics.driver</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="name"/>
                <field name="phone"/>
                <field name="status"/>
                <field name="license_is_valid"/>
                <field name="current_vehicle_id"/>
                <field name="image_128"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <img t-att-src="kanban_image('logistics.driver', 'image_128', record.id.raw_value)" 
                                        class="o_kanban_image" alt="Driver"/>
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                        <span t-if="!record.license_is_valid.raw_value" class="badge text-bg-danger">
                                            License Expired
                                        </span>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><i class="fa fa-phone"/> <field name="phone"/></div>
                                    <div t-if="record.current_vehicle_id.raw_value">
                                        <i class="fa fa-truck"/> <field name="current_vehicle_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <span t-attf-class="badge #{record.status.raw_value == 'available' ? 'text-bg-success' : record.status.raw_value == 'on_trip' ? 'text-bg-info' : 'text-bg-warning'}">
                                        <field name="status"/>
                                    </span>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Driver Action -->
    <record id="action_logistics_driver" model="ir.actions.act_window">
        <field name="name">Drivers</field>
        <field name="res_model">logistics.driver</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_logistics_driver_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Register your first driver
            </p>
            <p>
                Manage your driver workforce for vehicle assignments.
            </p>
        </field>
    </record>
</odoo>
