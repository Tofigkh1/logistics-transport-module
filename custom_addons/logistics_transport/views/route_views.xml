<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Route Tree View -->
    <record id="view_logistics_route_tree" model="ir.ui.view">
        <field name="name">logistics.route.tree</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <tree string="Routes">
                <field name="name"/>
                <field name="code"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="distance_km"/>
                <field name="estimated_time_display" string="Est. Time"/>
                <field name="route_type" widget="badge"/>
                <field name="waypoint_count"/>
                <field name="usage_count"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Route Form View -->
    <record id="view_logistics_route_form" model="ir.ui.view">
        <field name="name">logistics.route.form</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <form string="Route">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_logistics_shipment)d" type="action"
                            class="oe_stat_button" icon="fa-truck"
                            context="{'search_default_route_id': active_id}">
                            <field name="usage_count" string="Shipments" widget="statinfo"/>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="Route Name"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="Route Code"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Route Details">
                            <field name="origin_id"/>
                            <field name="destination_id"/>
                            <field name="route_type"/>
                            <field name="active" invisible="1"/>
                        </group>
                        <group string="Distance &amp; Time">
                            <field name="distance_km"/>
                            <field name="estimated_hours"/>
                            <field name="estimated_time_display"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Waypoints" name="waypoints">
                            <field name="waypoint_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="location_id"/>
                                    <field name="waypoint_type"/>
                                    <field name="estimated_arrival"/>
                                    <field name="estimated_duration"/>
                                    <field name="notes"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Description" name="description">
                            <field name="description" placeholder="Route description and instructions..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Route Search View -->
    <record id="view_logistics_route_search" model="ir.ui.view">
        <field name="name">logistics.route.search</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <search string="Search Routes">
                <field name="name"/>
                <field name="code"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <filter string="Direct Routes" name="direct" domain="[('route_type', '=', 'direct')]"/>
                <filter string="Multi-Stop" name="multi_stop" domain="[('route_type', '=', 'multi_stop')]"/>
                <filter string="Round Trip" name="round_trip" domain="[('route_type', '=', 'round_trip')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Type" name="group_type" context="{'group_by': 'route_type'}"/>
                    <filter string="Origin" name="group_origin" context="{'group_by': 'origin_id'}"/>
                    <filter string="Destination" name="group_destination" context="{'group_by': 'destination_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Route Kanban View -->
    <record id="view_logistics_route_kanban" model="ir.ui.view">
        <field name="name">logistics.route.kanban</field>
        <field name="model">logistics.route</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile">
                <field name="name"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="distance_km"/>
                <field name="estimated_time_display"/>
                <field name="route_type"/>
                <field name="waypoint_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span class="badge text-bg-secondary">
                                        <field name="route_type"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div>
                                        <i class="fa fa-map-marker text-success"/> <field name="origin_id"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-arrow-down"/>
                                    </div>
                                    <div>
                                        <i class="fa fa-map-marker text-danger"/> <field name="destination_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><i class="fa fa-road"/> <field name="distance_km"/> km</span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span><i class="fa fa-clock-o"/> <field name="estimated_time_display"/></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Route Action -->
    <record id="action_logistics_route" model="ir.actions.act_window">
        <field name="name">Routes</field>
        <field name="res_model">logistics.route</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_logistics_route_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first route
            </p>
            <p>
                Define routes between locations with waypoints and estimated travel times.
            </p>
        </field>
    </record>
</odoo>
