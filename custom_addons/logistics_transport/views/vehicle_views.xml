<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vehicle Tree View -->
    <record id="view_logistics_vehicle_tree" model="ir.ui.view">
        <field name="name">logistics.vehicle.tree</field>
        <field name="model">logistics.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Vehicles" decoration-muted="status == 'out_of_service'" decoration-warning="status == 'maintenance'">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="driver_id"/>
                <field name="capacity_weight"/>
                <field name="capacity_volume"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'available'"
                    decoration-info="status == 'in_use'"
                    decoration-warning="status == 'maintenance'"
                    decoration-danger="status == 'out_of_service'"/>
                <field name="active" invisible="1"/>
            </tree>
        </field>
    </record>

    <!-- Vehicle Form View -->
    <record id="view_logistics_vehicle_form" model="ir.ui.view">
        <field name="name">logistics.vehicle.form</field>
        <field name="model">logistics.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <header>
                    <button name="action_set_available" string="Set Available" type="object" 
                        class="oe_highlight" invisible="status == 'available'"/>
                    <button name="action_set_maintenance" string="Send to Maintenance" type="object"
                        invisible="status == 'maintenance'"/>
                    <button name="action_set_out_of_service" string="Out of Service" type="object"
                        invisible="status == 'out_of_service'"/>
                    <field name="status" widget="statusbar" statusbar_visible="available,in_use,maintenance"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_logistics_shipment)d" type="action"
                            class="oe_stat_button" icon="fa-truck"
                            context="{'search_default_vehicle_id': active_id}">
                            <field name="total_trips" string="Trips" widget="statinfo"/>
                        </button>
                    </div>
                    <field name="image_128" widget="image" class="oe_avatar"/>
                    <widget name="web_ribbon" title="Out of Service" bg_color="text-bg-danger" invisible="status != 'out_of_service'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Vehicle Name"/>
                        </h1>
                        <h3>
                            <field name="license_plate" placeholder="License Plate"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Vehicle Info">
                            <field name="vehicle_type"/>
                            <field name="brand"/>
                            <field name="model"/>
                            <field name="year"/>
                            <field name="color"/>
                            <field name="vin"/>
                        </group>
                        <group string="Capacity">
                            <field name="capacity_weight"/>
                            <field name="capacity_volume"/>
                        </group>
                    </group>
                    <group>
                        <group string="Assignment">
                            <field name="driver_id"/>
                            <field name="current_driver_id"/>
                            <field name="current_shipment_id"/>
                        </group>
                        <group string="Fuel">
                            <field name="fuel_type"/>
                            <field name="fuel_capacity"/>
                            <field name="fuel_efficiency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Registration &amp; Insurance" name="registration">
                            <group>
                                <group>
                                    <field name="registration_date"/>
                                    <field name="registration_expiry"/>
                                </group>
                                <group>
                                    <field name="insurance_policy"/>
                                    <field name="insurance_expiry"/>
                                </group>
                            </group>
                        </page>
                        <page string="Maintenance" name="maintenance">
                            <group>
                                <group>
                                    <field name="odometer"/>
                                    <field name="last_maintenance_date"/>
                                </group>
                                <group>
                                    <field name="next_maintenance_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Statistics" name="statistics">
                            <group>
                                <group>
                                    <field name="total_trips"/>
                                    <field name="total_distance"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Vehicle Search View -->
    <record id="view_logistics_vehicle_search" model="ir.ui.view">
        <field name="name">logistics.vehicle.search</field>
        <field name="model">logistics.vehicle</field>
        <field name="arch" type="xml">
            <search string="Search Vehicles">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="driver_id"/>
                <filter string="Available" name="available" domain="[('status', '=', 'available')]"/>
                <filter string="In Use" name="in_use" domain="[('status', '=', 'in_use')]"/>
                <filter string="Maintenance" name="maintenance" domain="[('status', '=', 'maintenance')]"/>
                <separator/>
                <filter string="Trucks" name="truck" domain="[('vehicle_type', '=', 'truck')]"/>
                <filter string="Vans" name="van" domain="[('vehicle_type', '=', 'van')]"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Type" name="group_type" context="{'group_by': 'vehicle_type'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Vehicle Kanban View -->
    <record id="view_logistics_vehicle_kanban" model="ir.ui.view">
        <field name="name">logistics.vehicle.kanban</field>
        <field name="model">logistics.vehicle</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" default_group_by="status">
                <field name="name"/>
                <field name="license_plate"/>
                <field name="vehicle_type"/>
                <field name="driver_id"/>
                <field name="status"/>
                <field name="capacity_weight"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-attf-class="badge #{record.status.raw_value == 'available' ? 'text-bg-success' : record.status.raw_value == 'in_use' ? 'text-bg-info' : record.status.raw_value == 'maintenance' ? 'text-bg-warning' : 'text-bg-danger'}">
                                        <field name="status"/>
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong><field name="license_plate"/></strong></div>
                                    <div><field name="vehicle_type"/></div>
                                    <div t-if="record.driver_id.raw_value">
                                        <i class="fa fa-user"/> <field name="driver_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><field name="capacity_weight"/> kg</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Vehicle Action -->
    <record id="action_logistics_vehicle" model="ir.actions.act_window">
        <field name="name">Vehicles</field>
        <field name="res_model">logistics.vehicle</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_logistics_vehicle_search"/>
        <field name="context">{'search_default_available': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add your first vehicle
            </p>
            <p>
                Register vehicles that will be used for shipment deliveries.
            </p>
        </field>
    </record>
</odoo>
