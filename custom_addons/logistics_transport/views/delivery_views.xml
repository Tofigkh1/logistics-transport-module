<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Delivery Tree View -->
    <record id="view_logistics_delivery_tree" model="ir.ui.view">
        <field name="name">logistics.delivery.tree</field>
        <field name="model">logistics.delivery</field>
        <field name="arch" type="xml">
            <tree string="Deliveries" decoration-warning="status == 'in_transit'" 
                decoration-success="status == 'delivered'" decoration-danger="status == 'failed'">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="driver_id"/>
                <field name="vehicle_id"/>
                <field name="departure_time"/>
                <field name="arrival_time"/>
                <field name="transit_duration_display"/>
                <field name="status" widget="badge"
                    decoration-secondary="status == 'pending'"
                    decoration-info="status == 'departed'"
                    decoration-warning="status == 'in_transit'"
                    decoration-primary="status == 'arrived'"
                    decoration-success="status == 'delivered'"
                    decoration-danger="status == 'failed'"/>
                <field name="has_pod" widget="boolean"/>
            </tree>
        </field>
    </record>

    <!-- Delivery Form View -->
    <record id="view_logistics_delivery_form" model="ir.ui.view">
        <field name="name">logistics.delivery.form</field>
        <field name="model">logistics.delivery</field>
        <field name="arch" type="xml">
            <form string="Delivery">
                <header>
                    <button name="action_depart" string="Depart" type="object"
                        class="oe_highlight" invisible="status != 'pending'"/>
                    <button name="action_in_transit" string="In Transit" type="object"
                        class="oe_highlight" invisible="status != 'departed'"/>
                    <button name="action_arrive" string="Arrive" type="object"
                        class="oe_highlight" invisible="status != 'in_transit'"/>
                    <button name="action_deliver" string="Delivered" type="object"
                        class="oe_highlight" invisible="status != 'arrived'"/>
                    <button name="action_fail" string="Failed" type="object"
                        invisible="status in ('delivered', 'failed')"/>
                    <button name="action_retry" string="Retry" type="object"
                        invisible="status != 'failed'"/>
                    <field name="status" widget="statusbar" statusbar_visible="pending,departed,in_transit,arrived,delivered"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_capture_pod" type="object"
                            class="oe_stat_button" icon="fa-camera"
                            invisible="status not in ('arrived', 'delivered')">
                            <span>Capture POD</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Failed" bg_color="text-bg-danger" invisible="status != 'failed'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Shipment Details">
                            <field name="shipment_id"/>
                            <field name="customer_id"/>
                            <field name="origin_id"/>
                            <field name="destination_id"/>
                        </group>
                        <group string="Assignment">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                            <field name="delivery_attempts"/>
                        </group>
                    </group>
                    <group>
                        <group string="Timing">
                            <field name="departure_time"/>
                            <field name="arrival_time"/>
                            <field name="transit_duration"/>
                            <field name="transit_duration_display"/>
                        </group>
                        <group string="Location Tracking">
                            <field name="current_location"/>
                            <field name="current_latitude"/>
                            <field name="current_longitude"/>
                            <field name="last_update"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Proof of Delivery" name="pod">
                            <field name="pod_ids">
                                <tree>
                                    <field name="name"/>
                                    <field name="recipient_name"/>
                                    <field name="condition" widget="badge"/>
                                    <field name="timestamp"/>
                                    <field name="is_verified" widget="boolean"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Failure Details" name="failure" invisible="status != 'failed'">
                            <group>
                                <field name="failure_reason"/>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <group>
                                    <field name="notes" placeholder="General notes..."/>
                                </group>
                                <group>
                                    <field name="driver_notes" placeholder="Driver notes..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Delivery Search View -->
    <record id="view_logistics_delivery_search" model="ir.ui.view">
        <field name="name">logistics.delivery.search</field>
        <field name="model">logistics.delivery</field>
        <field name="arch" type="xml">
            <search string="Search Deliveries">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="driver_id"/>
                <filter string="Pending" name="pending" domain="[('status', '=', 'pending')]"/>
                <filter string="In Transit" name="in_transit" domain="[('status', '=', 'in_transit')]"/>
                <filter string="Delivered" name="delivered" domain="[('status', '=', 'delivered')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <separator/>
                <filter string="Has POD" name="has_pod" domain="[('has_pod', '=', True)]"/>
                <filter string="No POD" name="no_pod" domain="[('has_pod', '=', False), ('status', '=', 'delivered')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Departure Date" name="group_departure" context="{'group_by': 'departure_time:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Delivery Kanban View -->
    <record id="view_logistics_delivery_kanban" model="ir.ui.view">
        <field name="name">logistics.delivery.kanban</field>
        <field name="model">logistics.delivery</field>
        <field name="arch" type="xml">
            <kanban default_group_by="status" class="o_kanban_mobile">
                <field name="name"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="driver_id"/>
                <field name="status"/>
                <field name="has_pod"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <span t-if="record.has_pod.raw_value" class="badge text-bg-success">
                                        <i class="fa fa-check"/> POD
                                    </span>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><field name="shipment_id"/></div>
                                    <div><strong><field name="customer_id"/></strong></div>
                                    <div t-if="record.driver_id.raw_value">
                                        <i class="fa fa-user"/> <field name="driver_id"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Delivery Action -->
    <record id="action_logistics_delivery" model="ir.actions.act_window">
        <field name="name">Deliveries</field>
        <field name="res_model">logistics.delivery</field>
        <field name="view_mode">kanban,tree,form</field>
        <field name="search_view_id" ref="view_logistics_delivery_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No deliveries yet
            </p>
            <p>
                Delivery records are created automatically when shipments are dispatched.
            </p>
        </field>
    </record>

    <!-- POD Tree View -->
    <record id="view_logistics_pod_tree" model="ir.ui.view">
        <field name="name">logistics.proof.of.delivery.tree</field>
        <field name="model">logistics.proof.of.delivery</field>
        <field name="arch" type="xml">
            <tree string="Proof of Delivery">
                <field name="name"/>
                <field name="delivery_id"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="recipient_name"/>
                <field name="condition" widget="badge"
                    decoration-success="condition == 'good'"
                    decoration-warning="condition == 'minor_damage'"
                    decoration-danger="condition in ('major_damage', 'partial')"/>
                <field name="timestamp"/>
                <field name="is_verified" widget="boolean"/>
            </tree>
        </field>
    </record>

    <!-- POD Form View -->
    <record id="view_logistics_pod_form" model="ir.ui.view">
        <field name="name">logistics.proof.of.delivery.form</field>
        <field name="model">logistics.proof.of.delivery</field>
        <field name="arch" type="xml">
            <form string="Proof of Delivery">
                <header>
                    <button name="action_verify" string="Verify" type="object"
                        class="oe_highlight" invisible="is_verified"/>
                    <button name="action_unverify" string="Unverify" type="object"
                        invisible="not is_verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Verified" bg_color="text-bg-success" invisible="not is_verified"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Delivery Details">
                            <field name="delivery_id"/>
                            <field name="shipment_id"/>
                            <field name="customer_id"/>
                            <field name="driver_id"/>
                        </group>
                        <group string="Recipient">
                            <field name="recipient_name"/>
                            <field name="recipient_id_number"/>
                            <field name="recipient_position"/>
                            <field name="recipient_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Delivery Status">
                            <field name="condition"/>
                            <field name="items_delivered"/>
                            <field name="items_rejected"/>
                            <field name="timestamp"/>
                        </group>
                        <group string="Location">
                            <field name="latitude"/>
                            <field name="longitude"/>
                            <field name="delivery_address"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Signature &amp; Photo" name="media">
                            <group>
                                <group>
                                    <field name="signature" widget="image"/>
                                </group>
                                <group>
                                    <field name="photo" widget="image"/>
                                </group>
                            </group>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <field name="notes" placeholder="Delivery notes from driver..."/>
                            </group>
                            <group>
                                <field name="recipient_notes" placeholder="Comments from recipient..."/>
                            </group>
                            <group invisible="condition == 'good'">
                                <field name="damage_description" placeholder="Describe any damage..."/>
                            </group>
                        </page>
                        <page string="Verification" name="verification">
                            <group>
                                <group>
                                    <field name="is_verified"/>
                                    <field name="verified_by"/>
                                    <field name="verified_date"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- POD Search View -->
    <record id="view_logistics_pod_search" model="ir.ui.view">
        <field name="name">logistics.proof.of.delivery.search</field>
        <field name="model">logistics.proof.of.delivery</field>
        <field name="arch" type="xml">
            <search string="Search POD">
                <field name="name"/>
                <field name="delivery_id"/>
                <field name="shipment_id"/>
                <field name="customer_id"/>
                <field name="recipient_name"/>
                <filter string="Verified" name="verified" domain="[('is_verified', '=', True)]"/>
                <filter string="Pending Verification" name="pending" domain="[('is_verified', '=', False)]"/>
                <separator/>
                <filter string="Good Condition" name="good" domain="[('condition', '=', 'good')]"/>
                <filter string="Has Damage" name="damaged" domain="[('condition', 'in', ['minor_damage', 'major_damage'])]"/>
                <group expand="0" string="Group By">
                    <filter string="Condition" name="group_condition" context="{'group_by': 'condition'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Verified" name="group_verified" context="{'group_by': 'is_verified'}"/>
                    <filter string="Date" name="group_date" context="{'group_by': 'timestamp:day'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- POD Action -->
    <record id="action_logistics_pod" model="ir.actions.act_window">
        <field name="name">Proof of Delivery</field>
        <field name="res_model">logistics.proof.of.delivery</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_logistics_pod_search"/>
        <field name="context">{'search_default_pending': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No proof of delivery records yet
            </p>
            <p>
                POD records are created when deliveries are completed.
            </p>
        </field>
    </record>
</odoo>
