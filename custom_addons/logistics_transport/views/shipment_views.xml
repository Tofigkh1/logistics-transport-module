<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shipment Tree View -->
    <record id="view_logistics_shipment_tree" model="ir.ui.view">
        <field name="name">logistics.shipment.tree</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <tree string="Shipments" decoration-info="state == 'draft'" 
                decoration-warning="state in ('confirmed', 'dispatched')"
                decoration-success="state in ('delivered', 'done')"
                decoration-muted="state == 'cancelled'">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="scheduled_pickup" widget="date"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="total_weight"/>
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-primary="state == 'confirmed'"
                    decoration-warning="state == 'dispatched'"
                    decoration-success="state in ('in_transit', 'delivered', 'done')"
                    decoration-danger="state == 'cancelled'"/>
                <field name="priority" widget="priority"/>
            </tree>
        </field>
    </record>

    <!-- Shipment Form View -->
    <record id="view_logistics_shipment_form" model="ir.ui.view">
        <field name="name">logistics.shipment.form</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <form string="Shipment">
                <header>
                    <button name="action_confirm" string="Confirm" type="object"
                        class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_dispatch" string="Dispatch" type="object"
                        class="oe_highlight" invisible="state != 'confirmed'"/>
                    <button name="action_start_transit" string="Start Delivery" type="object"
                        class="oe_highlight" invisible="state != 'dispatched'"/>
                    <button name="action_mark_delivered" string="Mark Delivered" type="object"
                        class="oe_highlight" invisible="state != 'in_transit'"/>
                    <button name="action_complete" string="Complete" type="object"
                        class="oe_highlight" invisible="state != 'delivered'"/>
                    <button name="action_cancel" string="Cancel" type="object"
                        invisible="state in ('in_transit', 'delivered', 'done', 'cancelled')"/>
                    <button name="action_reset_to_draft" string="Reset to Draft" type="object"
                        invisible="state != 'cancelled'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,dispatched,in_transit,delivered,done"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_invoices" type="object"
                            class="oe_stat_button" icon="fa-pencil-square-o"
                            invisible="invoice_count == 0">
                            <field name="invoice_count" string="Invoices" widget="statinfo"/>
                        </button>
                        <button name="action_create_invoice" type="object"
                            class="oe_stat_button" icon="fa-plus"
                            invisible="state not in ('delivered', 'done') or invoice_count > 0">
                            <span>Create Invoice</span>
                        </button>
                    </div>
                    <widget name="web_ribbon" title="Cancelled" bg_color="text-bg-danger" invisible="state != 'cancelled'"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Customer">
                            <field name="customer_id"/>
                            <field name="customer_reference"/>
                            <field name="sale_order_id"/>
                            <field name="priority" widget="priority"/>
                        </group>
                        <group string="Locations">
                            <field name="origin_id"/>
                            <field name="destination_id"/>
                            <field name="route_id"/>
                            <field name="distance_km" readonly="1"/>
                        </group>
                    </group>
                    <group>
                        <group string="Schedule">
                            <field name="scheduled_pickup"/>
                            <field name="scheduled_delivery"/>
                            <field name="actual_pickup" readonly="1"/>
                            <field name="actual_delivery" readonly="1"/>
                        </group>
                        <group string="Assignment">
                            <field name="vehicle_id"/>
                            <field name="driver_id"/>
                        </group>
                    </group>
                    
                    <!-- Capacity Warning -->
                    <div invisible="not capacity_warning" class="alert alert-warning" role="alert">
                        <i class="fa fa-warning"/> <field name="capacity_warning" readonly="1"/>
                    </div>
                    
                    <notebook>
                        <page string="Items" name="items">
                            <field name="item_ids">
                                <tree editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="name"/>
                                    <field name="product_id" optional="hide"/>
                                    <field name="quantity"/>
                                    <field name="uom"/>
                                    <field name="weight"/>
                                    <field name="volume"/>
                                    <field name="package_type"/>
                                    <field name="package_count"/>
                                    <field name="is_fragile" widget="boolean_toggle"/>
                                    <field name="is_hazardous" widget="boolean_toggle"/>
                                    <field name="total_weight" sum="Total Weight"/>
                                    <field name="total_volume" sum="Total Volume"/>
                                </tree>
                            </field>
                            <group class="oe_subtotal_footer">
                                <field name="total_items" string="Total Items"/>
                                <field name="total_weight" string="Total Weight (kg)"/>
                                <field name="total_volume" string="Total Volume (m³)"/>
                            </group>
                        </page>
                        <page string="Deliveries" name="deliveries">
                            <field name="delivery_ids" readonly="1">
                                <tree>
                                    <field name="name"/>
                                    <field name="status" widget="badge"/>
                                    <field name="departure_time"/>
                                    <field name="arrival_time"/>
                                    <field name="transit_duration_display"/>
                                    <field name="has_pod"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Notes" name="notes">
                            <group>
                                <group>
                                    <field name="notes" placeholder="Notes visible to customer..."/>
                                </group>
                                <group>
                                    <field name="internal_notes" placeholder="Internal notes..."/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <!-- Shipment Search View -->
    <record id="view_logistics_shipment_search" model="ir.ui.view">
        <field name="name">logistics.shipment.search</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <search string="Search Shipments">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="customer_reference"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]"/>
                <filter string="Confirmed" name="confirmed" domain="[('state', '=', 'confirmed')]"/>
                <filter string="Dispatched" name="dispatched" domain="[('state', '=', 'dispatched')]"/>
                <filter string="In Transit" name="in_transit" domain="[('state', '=', 'in_transit')]"/>
                <filter string="Delivered" name="delivered" domain="[('state', '=', 'delivered')]"/>
                <filter string="Completed" name="done" domain="[('state', '=', 'done')]"/>
                <separator/>
                <filter string="Today's Pickups" name="today_pickup" 
                    domain="[('scheduled_pickup', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                            ('scheduled_pickup', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <filter string="Today's Deliveries" name="today_delivery" 
                    domain="[('scheduled_delivery', '&gt;=', datetime.datetime.combine(context_today(), datetime.time(0,0,0)).strftime('%Y-%m-%d %H:%M:%S')),
                            ('scheduled_delivery', '&lt;', (context_today() + relativedelta(days=1)).strftime('%Y-%m-%d'))]"/>
                <separator/>
                <filter string="Urgent" name="urgent" domain="[('priority', '=', '3')]"/>
                <filter string="Late" name="late" domain="[('scheduled_delivery', '&lt;', context_today().strftime('%Y-%m-%d')), ('state', 'not in', ['done', 'cancelled'])]"/>
                <separator/>
                <filter string="My Shipments" name="my_shipments" domain="[('create_uid', '=', uid)]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                    <filter string="Customer" name="group_customer" context="{'group_by': 'customer_id'}"/>
                    <filter string="Vehicle" name="group_vehicle" context="{'group_by': 'vehicle_id'}"/>
                    <filter string="Driver" name="group_driver" context="{'group_by': 'driver_id'}"/>
                    <filter string="Pickup Date" name="group_pickup" context="{'group_by': 'scheduled_pickup:day'}"/>
                    <filter string="Priority" name="group_priority" context="{'group_by': 'priority'}"/>
                </group>
            </search>
        </field>
    </record>

    <!-- Shipment Kanban View -->
    <record id="view_logistics_shipment_kanban" model="ir.ui.view">
        <field name="name">logistics.shipment.kanban</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <kanban default_group_by="state" class="o_kanban_mobile">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="scheduled_pickup"/>
                <field name="vehicle_id"/>
                <field name="driver_id"/>
                <field name="state"/>
                <field name="priority"/>
                <field name="total_weight"/>
                <field name="color"/>
                <progressbar field="state" colors='{"draft": "secondary", "confirmed": "info", "dispatched": "warning", "in_transit": "primary", "delivered": "success", "done": "success", "cancelled": "danger"}'/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click #{kanban_color(record.color.raw_value)}">
                            <div class="oe_kanban_content">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title">
                                            <field name="name"/>
                                        </strong>
                                    </div>
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="o_kanban_record_body">
                                    <div><strong><field name="customer_id"/></strong></div>
                                    <div class="text-muted">
                                        <i class="fa fa-map-marker text-success"/> <field name="origin_id"/>
                                        <i class="fa fa-long-arrow-right mx-1"/>
                                        <i class="fa fa-map-marker text-danger"/> <field name="destination_id"/>
                                    </div>
                                    <div t-if="record.vehicle_id.raw_value" class="mt-1">
                                        <i class="fa fa-truck"/> <field name="vehicle_id"/>
                                    </div>
                                    <div t-if="record.driver_id.raw_value">
                                        <i class="fa fa-user"/> <field name="driver_id"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div class="oe_kanban_bottom_left">
                                        <span><i class="fa fa-calendar"/> <field name="scheduled_pickup" widget="date"/></span>
                                    </div>
                                    <div class="oe_kanban_bottom_right">
                                        <span><field name="total_weight"/> kg</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Shipment Calendar View -->
    <record id="view_logistics_shipment_calendar" model="ir.ui.view">
        <field name="name">logistics.shipment.calendar</field>
        <field name="model">logistics.shipment</field>
        <field name="arch" type="xml">
            <calendar string="Shipment Schedule" date_start="scheduled_pickup" date_stop="scheduled_delivery" 
                color="state" mode="week" quick_add="False">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="origin_id"/>
                <field name="destination_id"/>
                <field name="driver_id"/>
            </calendar>
        </field>
    </record>

    <!-- Shipment Action -->
    <record id="action_logistics_shipment" model="ir.actions.act_window">
        <field name="name">Shipments</field>
        <field name="res_model">logistics.shipment</field>
        <field name="view_mode">kanban,tree,form,calendar</field>
        <field name="search_view_id" ref="view_logistics_shipment_search"/>
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first shipment
            </p>
            <p>
                Book shipments to transport cargo from origin to destination.
            </p>
        </field>
    </record>
</odoo>
